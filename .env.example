# ==============================================================================
# Archivéo - Variables d'environnement pour Docker Compose (Modèle de configuration)
# Copiez ce fichier vers .env et définissez des valeurs secrètes fortes et uniques.
# ==============================================================================

# Base de données PostgreSQL
POSTGRES_DB=archiveo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangerCeMotDePasseEnProduction!
POSTGRES_PORT=5432

# Backend & Sécurité JWT (La clé secrète doit comporter au moins 32 caractères)
JWT_SECRET=RemplacerParUneCleSecreteAleatoireForteDeAuMoins32Caracteres!
JWT_ISSUER=ArchiveoApi
JWT_AUDIENCE=ArchiveoClient
ADMIN_PASSWORD=ChangerCeMotDePasseAdminEnProduction!

# URL de l'API pour le Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
