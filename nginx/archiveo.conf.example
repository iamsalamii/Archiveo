# ==============================================================================
# ARCHIVÉO ENTERPRISE — MODÈLE DE CONFIGURATION NGINX DE RÉFÉRENCE (PHASE 5B)
# Fichier à copier dans : /etc/nginx/sites-available/archiveo.conf
# Puis activer via : sudo ln -s /etc/nginx/sites-available/archiveo.conf /etc/nginx/sites-enabled/
# ==============================================================================

# ==============================================================================
# REMARQUE ARCHITECTURE MULTI-SITES & CONTEXTE NGINX (DIRECTIVE 'map') :
# 1. Contexte obligatoire : la directive 'map' ci-dessous DOIT résider dans le
#    bloc 'http { ... }'. Elle est autorisée en tête de ce fichier uniquement
#    si ce fichier est inclus directement dans le bloc 'http' de /etc/nginx/nginx.conf
#    (cas par défaut de Debian/Ubuntu via : include /etc/nginx/sites-enabled/*;).
# 2. Risque de collision en environnement multi-sites :
#    Si la variable '$connection_upgrade' est DÉJÀ déclarée dans votre /etc/nginx/nginx.conf
#    ou dans un autre fichier de configuration inclus (ex: /etc/nginx/conf.d/websocket.conf),
#    Nginx rejettera la configuration au rechargement avec l'erreur :
#    "nginx: [emerg] the duplicate 'connection_upgrade' variable".
#    Dans ce cas, COMMENTEZ simplement le bloc 'map' ci-dessous (lignes 22 à 25).
# ==============================================================================

# Mapping pour la gestion des WebSockets (SignalR pour /hubs/notifications)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Redirection HTTP vers HTTPS (Port 80 -> 443)
server {
    listen 80;
    listen [::]:80;
    server_name archiveo.entreprise.com;

    # Défi ACME pour le renouvellement automatique Let's Encrypt / Certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Serveur Principal Sécurisé (HTTPS 443)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name archiveo.entreprise.com;

    # Chemins des certificats SSL (configurés automatiquement par Certbot)
    ssl_certificate /etc/letsencrypt/live/archiveo.entreprise.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/archiveo.entreprise.com/privkey.pem;

    # Paramètres SSL stricts (Mozilla Modern Recommendation)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # En-têtes de sécurité renforcés
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Taille maximale des téléversements de documents
    client_max_body_size 50M;

    # --------------------------------------------------------------------------
    # 1. Routage vers l'API Backend ASP.NET Core (.NET 9) sur port 5000 (localhost)
    # --------------------------------------------------------------------------
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        # En-têtes transférés obligatoires pour le Rate Limiter et ASP.NET Core
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts pour les opérations longues (génération rapports, gros documents)
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Documentation Swagger (optionnelle en production)
    location /swagger {
        proxy_pass http://127.0.0.1:5000/swagger;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --------------------------------------------------------------------------
    # 2. Routage WebSockets pour les Hubs SignalR (/hubs/notifications)
    # --------------------------------------------------------------------------
    location /hubs/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        # Directives WebSockets indispensables
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Désactiver le buffer pour les flux temps réel
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --------------------------------------------------------------------------
    # 3. Routage vers l'application Frontend Next.js sur port 3000 (localhost)
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Support HMR / WebSockets Next.js
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
